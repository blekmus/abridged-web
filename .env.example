ARCHIVE_ROOT=../archive
PORT=8080


# development = use local built frontend files
# production = use embedded assets inside binary
APP_ENV=development

# debug, info, warn, or error
LOG_LEVEL=info
# text or json (defaults to text in development, json in production)
LOG_FORMAT=text

# Absolute public origin used by robots.txt and sitemap.xml.
# Leave empty to derive it from the request Host/X-Forwarded-Proto.
PUBLIC_BASE_URL=
