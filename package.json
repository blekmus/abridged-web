{
  "name": "abridged-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "vite",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write --verbose .",
    "build": "bun run fix && bun run check && vite build && bun run frontend/prerender.tsx"
  },
  "dependencies": {
    "preact": "^10.26.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^24.7.2",
    "@types/three": "^0.186.0",
    "@yushijinhun/three-minifier-rollup": "^0.4.0",
    "preact-render-to-string": "^6.8.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
